# Flask Configuration
SECRET_KEY=your_secret_key_here

# PostgreSQL Database (requires pgvector extension)
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillvector_hr

# AI API Keys (Provide at least one: Google Gemini or OpenAI)
GOOGLE_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key

# Email Sending (Optional - for candidate notification emails)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SENDER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Google Forms Integration (Optional)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Webhook Security (Optional)
WEBHOOK_SECRET=your_webhook_secret
